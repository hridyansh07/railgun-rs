
# ENV To test real wallets against the computed merkle roots and check whether decrypted roots 
# are actually correct and UTXOs are correctly handled 

# --- Test wallet -----------------------------------------------------------------
# A BIP-39 mnemonic for a throwaway test wallet. The classic dev vector is fine for a
# deterministic, public wallet; use your own to test against your real on-chain txns.
RAILGUN_TEST_MNEMONIC="test test test test test test test test test test test junk"

# RAILGUN account index to derive (default 0).
RAILGUN_TEST_ACCOUNT_INDEX=0

# The wallet's authoritative 0zk address, copied from a real RAILGUN client. The
# parity test derives the address from the mnemonic and asserts it equals this string
RAILGUN_TEST_0ZK="0zk1..."

# --- Fixture -----------------------------------------------------------------------
# Default Database path for Sepolia Redb
RAILGUN_REDB_FIXTURE="/abs/path/to/sepolia.redb"

# Sync Window for the transactions ideally shield and use shielded transaction block - 1 with a span of 1M blocks
# Ensuring merkle is densely populated
RAILGUN_SYNC_FROM=5784774
RAILGUN_SYNC_SPAN=200000
